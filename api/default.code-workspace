{
	"folders": [
		{
			"name": "api",
			"path": "."
		},
		{
			"name": "shared",
			"path": "../shared"
		}
	],
	"settings": {
		"explorer.autoRevealExclude": {
			"**/node_modules": true,
			"**/vendor": true
		},
		"php-cs-fixer.executablePath": "${workspaceFolder}/bin/php-cs-fixer",
		"php-cs-fixer.autoFixByBracket": true,
		"php-cs-fixer.autoFixBySemicolon": true,
        "php-cs-fixer.exclude": ["**/var", "**/vendor", "**/node_modules"],
	},
	"extensions": {
		"recommendations": [
			"eamodio.gitlens"
		]
	}
}