{
    "extends": "../../tsconfig",
    "compilerOptions": {
        "outDir": "../../public/app",
        "paths": {
            "@components/*": [
                "./components/*",
            ],
            "@hooks/*": [
                "./hooks/*",
            ],
            "@models/*": [
                "./models/*"
            ],
            "@api/types/*": [
                "../../../shared/api/types/*"
            ],
            "@api/utils/*": [
                "../../../shared/api/utils/*"
            ],
            "ky": [
                "../../node_modules/ky"
            ],
            "@services/*": [
                "./services/*"
            ]
        },
    }
}