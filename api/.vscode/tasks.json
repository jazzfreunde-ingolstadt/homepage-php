{
	"version": "2.0.0",
	"tasks": [
        {
            "label": "composer install",
            "type": "shell",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "command": "composer install",
            "options": {
                "cwd": "${workspaceFolder}",
            },
            "presentation": {
                "clear": true
            }
        },
        {
            "label": "npm install",
            "type": "shell",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "command": "npm install",
            "options": {
                "cwd": "${workspaceFolder}",
            },
            "presentation": {
                "clear": true
            }
        },
        {
            "label": "Update autoloader",
            "detail": "Aktualisiere Autoloader Class Maps",
            "type": "shell",
            "problemMatcher": [],
            "group": "build",
            "command": "composer dump-autoload",
            "options": {
                "cwd": "${workspaceFolder}",
            },
            "presentation": {
                "clear": true
            }
        },
        {
            "label": "Migrate database",
            "type": "shell",
            "group": "test",
            "command": "bin/console",
            "args": [
                "doctrine:migrations:migrate",
                "--no-interaction"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
            },
        },
        {
            "label": "build encore",
            "type": "shell",
            "group": "build",
            "command": "npm run app:build:dev && npm run mail:build:dev",
            "presentation": {
                "clear": true,
                "showReuseMessage": false
            },
            "options": {
                "cwd": "${workspaceFolder}",
            },
        },
        {
            "label": "Run Unit Tests",
            "type": "shell",
            "group": "test",
            "command": "bin/phpunit",
            "args": [
                "--testdox",
                "--testsuite=unit,integration,functional",
                "--display-notices",
                "--display-phpunit-notices",
                "--display-deprecations",
                "--display-phpunit-deprecations",
                "--display-warnings"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "XDEBUG_MODE": "coverage"
                }
            },
            "problemMatcher": {
                "owner": "phpunit",
                "source": "phpunit",
                "fileLocation": [
                    "absolute"
                ],
                "severity": "error",
                "pattern": {
                    "regexp": "^##teamcity\\[testFailed\\sname\\=\\'(\\w+)\\'\\smessage\\=\\'(.+?)\\'\\sdetails\\=\\'(?:.*?)\\|n([\\w\\/\\\\]+\\.php)\\:(\\d+)\\|n'.*?\\]$",
                    "file": 3,
                    "line": 4,
                    "message": 2,
                }
            },
            "presentation": {
                "clear": true
            }
        },
        {
            "label": "Profile Unit Tests",
            "detail": "Run tests and write their durations to a JUnit report",
            "type": "shell",
            "group": "test",
            "command": "bin/phpunit",
            "args": [
                "--testsuite=unit,integration,functional",
                "--log-junit=var/log/junit.xml"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "XDEBUG_MODE": "off"
                }
            },
            "presentation": {
                "clear": true
            }
        },
        {
            "label": "Static Code Analysis",
            "type": "shell",
            "group": "test",
            "command": "bin/psalm",
            "options": {
                "cwd": "${workspaceFolder}",
            },
            "args": [
                "-c=psalm.xml",
            ],
            "problemMatcher": {
                "owner": "psalm",
                "source": "psalm",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "severity": "warning",
                "pattern": {
                    "regexp": "^(ERROR):\\s([^\\s]+)\\s-\\s([^:]+):([0-9]+):([0-9]+)\\s-\\s(.+)$",
                    "file": 3,
                    "line": 4,
                    "column": 5,
                    "severity": 1,
                    "message": 6,
                    "code": 2
                }
            },
            "presentation": {
                "showReuseMessage": false,
                "clear": true
            }
        },
        {
            "label": "Lint Twig templates",
            "type": "shell",
            "group": "test",
            "command": "bin/console",
            "args": [
                "lint:twig"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
            },
            "problemMatcher": {
                "owner": "twig",
                "source": "twig",
                "fileLocation": [
                    "absolute"
                ],
                "pattern": {
                    "regexp": "^\\s*ERROR\\s+in\\s+(.+?)\\s+\\(line\\s+(?:(\\d+)|-1)\\)$",
                    "file": 1,
                    "line": 2,
                    "message": 0,
                    "severity": "error"
                }
            },
            "presentation": {
                "clear": true
            }
        },
        {
            "label": "Check PHP Syntax",
            "type": "shell",
            "group": "build",
            "command": "bin/php-cs-fixer",
            "args": [
                "check"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Generate api spec",
            "type": "shell",
            "group": "build",
            "command": "composer run-script api:generate && npm run api:generate",
            "options": {
                "cwd": "${workspaceFolder}",
            },
        },
        {
            "label": "Dump sitemaps",
            "type": "shell",
            "group": "test",
            "command": "bin/console",
            "args": [
                "presta:sitemaps:dump",
                "--env=dev",
            ],
            "options": {
                "cwd": "${workspaceFolder}",
            },
        },
        {
            "label": "Consume message queue",
            "type": "shell",
            "group": "test",
            "command": "bin/console",
            "args": [
                "messenger:consume",
                "async",
                "--time-limit=15",
            ],
            "options": {
                "cwd": "${workspaceFolder}",
            },
        }
	]
}