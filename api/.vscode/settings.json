{
    "phpsab.composerJsonPath": "composer.json",
    "phpsab.standard": "ruleset.xml,Security",
    "phpsab.fixerArguments": [ "--ignore=vendor/*" ],
    "phpsab.snifferArguments": [ "--ignore=vendor/*" ],
    "[php]": {
        "editor.defaultFormatter": "valeryanm.vscode-phpsab"
    },
    "[yaml]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[js]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[twig]": {
        "editor.defaultFormatter": "mblode.twig-language-2"
    },
    "files.eol": "\n",
    "files.exclude": {
        "**/.git": true,
        "**/var/cache": true,
    },
    "php-docblocker.alignParams": true,
    "php-docblocker.alignReturn": true,
    "php.suggest.basic": false
}