{
    "name": "jazzfreunde-ingolstadt/api",
    "description": "API of the Jazzfreunde Ingolstadt e.V. website",
    "version": "1.0.0",
    "authors": [
        {
            "name": "Michael Mayer",
            "email": "info@miche-mayer.de",
            "role": "Webmaster"
        }
    ],
    "require": {
        "php": ">=8.2",
        "api-platform/core": "^4.1.1",
        "doctrine/annotations": "^2.0",
        "doctrine/doctrine-bundle": "^2.11",
        "doctrine/doctrine-migrations-bundle": "^3.3",
        "doctrine/orm": "^3.1",
        "endroid/qr-code-bundle": "^6.0",
        "jms/serializer-bundle": "^5.4",
        "michelf/php-markdown": "^2.0",
        "monolog/monolog": "^3.2",
        "nelmio/security-bundle": "^3.4",
        "presta/sitemap-bundle": "^4.1",
        "symfony/asset": "^7.2",
        "symfony/browser-kit": "^7.2",
        "symfony/console": "^7.2",
        "symfony/deprecation-contracts": "^3.2",
        "symfony/doctrine-messenger": "^7.2",
        "symfony/dotenv": "^7.2",
        "symfony/error-handler": "^7.2",
        "symfony/event-dispatcher": "^7.2",
        "symfony/expression-language": "^7.2",
        "symfony/filesystem": "^7.2",
        "symfony/flex": "^2.4",
        "symfony/form": "^7.2",
        "symfony/framework-bundle": "^7.2",
        "symfony/http-foundation": "^7.2",
        "symfony/ldap": "^7.2",
        "symfony/mailer": "^7.2",
        "symfony/maker-bundle": "1.*",
        "symfony/messenger": "^7.2",
        "symfony/monolog-bundle": "^3.8",
        "symfony/runtime": "^7.2",
        "symfony/scheduler": "^7.2",
        "symfony/security-bundle": "^7.2",
        "symfony/service-contracts": "*",
        "symfony/twig-bundle": "^7.2",
        "symfony/uid": "^7.2",
        "symfony/ux-react": "^2.22",
        "symfony/validator": "^7.2",
        "symfony/webpack-encore-bundle": "^2.1",
        "symfony/workflow": "^7.2",
        "symfony/yaml": "^7.2",
        "thecodingmachine/safe": "^3.0",
        "twig/cssinliner-extra": "^3.8",
        "twig/extra-bundle": "^3.8",
        "twig/markdown-extra": "^3.8"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "escapestudios/symfony2-coding-standard": "dev-master",
        "phpunit/phpunit": "^10.0",
        "psalm/plugin-phpunit": "dev-master",
        "psalm/plugin-symfony": "^5.2",
        "squizlabs/php_codesniffer": "3.12.1",
        "vimeo/psalm": "6.10.0"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "api:generate": "bin/console api:openapi:export --yaml --output=assets/app/api/specs/jazzfreunde-api.openapi.yaml"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^7.2",
            "docker": false
        },
        "src-dir": "src/",
        "public-dir": "public/"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "endroid/installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "autoload": {
        "psr-4": {
            "Jazzfreunde\\App\\": "src/",
            "Jazzfreunde\\": "libs/"  
        }
    }
}
