{
    "name": "jazzfreunde-ingolstadt/api",
    "description": "API of the Jazzfreunde Ingolstadt e.V. website",
    "version": "1.0.0",
    "authors": [
        {
            "name": "Michael Mayer",
            "email": "info@miche-mayer.de",
            "role": "Webmaster"
        }
    ],
    "require": {
        "php": ">=8.4.3",
        "api-platform/core": "5.0.5",
        "doctrine/doctrine-bundle": "^3.1",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7",
        "dragonmantank/cron-expression": "^3.6",
        "endroid/qr-code-bundle": "^6.0",
        "michelf/php-markdown": "^2.0",
        "monolog/monolog": "^3.2",
        "nelmio/security-bundle": "^3.4",
        "pelago/emogrifier": "^8.0",
        "presta/sitemap-bundle": "^4.1",
        "symfony/asset": "*",
        "symfony/browser-kit": "*",
        "symfony/console": "*",
        "symfony/deprecation-contracts": "*",
        "symfony/doctrine-messenger": "*",
        "symfony/dotenv": "*",
        "symfony/error-handler": "*",
        "symfony/event-dispatcher": "*",
        "symfony/expression-language": "*",
        "symfony/filesystem": "*",
        "symfony/flex": "^2.4",
        "symfony/form": "*",
        "symfony/framework-bundle": "*",
        "symfony/http-foundation": "*",
        "symfony/ldap": "*",
        "symfony/mailer": "*",
        "symfony/maker-bundle": "1.*",
        "symfony/messenger": "*",
        "symfony/monolog-bundle": "^4.1",
        "symfony/object-mapper": "*",
        "symfony/rate-limiter": "*",
        "symfony/runtime": "*",
        "symfony/scheduler": "*",
        "symfony/security-bundle": "*",
        "symfony/service-contracts": "*",
        "symfony/twig-bundle": "*",
        "symfony/uid": "*",
        "symfony/ux-react": "^2.22",
        "symfony/validator": "*",
        "symfony/webpack-encore-bundle": "^2.1",
        "symfony/workflow": "*",
        "symfony/yaml": "*",
        "thecodingmachine/safe": "^3.0",
        "twig/cssinliner-extra": "^3.26",
        "twig/extra-bundle": "^3.21",
        "twig/markdown-extra": "^3.21"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "doctrine/data-fixtures": "^2.2",
        "escapestudios/symfony2-coding-standard": "dev-master",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpunit/phpunit": "12.5.23",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "symfony/web-profiler-bundle": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "api:generate": "bin/console api:openapi:export --yaml --output=assets/app/api/specs/jazzfreunde-api.openapi.yaml"
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "^8.1",
            "docker": false
        },
        "src-dir": "src/",
        "public-dir": "public/"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "endroid/installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "autoload": {
        "psr-4": {
            "Jazzfreunde\\App\\": "src/",
            "Jazzfreunde\\": "libs/"  
        }
    }
}
