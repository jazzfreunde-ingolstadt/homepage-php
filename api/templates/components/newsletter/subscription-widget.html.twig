{% set subscription_form = newsletter_subscription_service.createForm().createView() %}

{% form_theme subscription_form 'tailwind_2_layout.html.twig' %}

{% embed 'components/util/message-box.html.twig' %}
	{% block box_content %}
		<div id="newsletter-subscription-widget" class="w-full overflow-hidden">
			<h2 class="text-xl md:text-2xl font-bold mb-2 text-blue">Sie möchten gerne auf dem Laufenden bleiben?</h2>
			<p class="text-xl md:text-2xl mb-5 md:mb-8 font-bold text-orange">Abonnieren Sie unseren Newsletter.</p>
			{% include 'components/util/error-flash.html.twig' %}
			{{ form_start(subscription_form) }}
			<div aria-hidden="true" style="position: absolute; left: -10000px; top: auto; width: 1px; height: 1px; overflow: hidden;">
				{{ form_widget(subscription_form.website) }}
			</div>
			<div class="w-full flex flex-col md:flex-row gap-5 lg:gap-10">
				<div class="relative w-full md:flex-shrink md:flex-grow">
					{{ form_widget(subscription_form.email, { attr: { class: 'block px-2.5 pb-2.5 pt-4 w-full text-sm text-grey bg-transparent rounded-lg border border-grey appearance-none focus:outline-none focus:ring-0 focus:border-blue peer' } }) }}
					{{ form_label(subscription_form.email, null, { label_attr: { class: 'absolute text-sm text-grey duration-300 transform -translate-y-4 scale-75 top-2 z-10 origin-[0] rounded bg-white px-2 peer-focus:px-2 peer-focus:text-blue peer-placeholder-shown:scale-100 peer-placeholder-shown:-translate-y-1/2 peer-placeholder-shown:top-1/2 peer-focus:top-2 peer-focus:scale-75 peer-focus:-translate-y-4 left-1' } }) }}
				</div>
				<div class="relative flex-none">{{ form_widget(subscription_form.subscribe, { attr: { class: 'bg-orange hover:bg-yellow text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline' } }) }}</div>
			</div>
			{{ form_end(subscription_form) }}
			<p class="mt-3 text-sm text-grey">
				Informationen zur Verarbeitung Ihrer Daten finden Sie in unserer
				<a href="{{ url('end-user-agreement-notifications') }}" target="_blank" rel="noopener noreferrer" class="font-bold text-blue underline">Datenschutzerklärung für Benachrichtigungen</a>.
			</p>
		</div>
	{% endblock %}
{% endembed %}
