{% apply inline_css(encore_entry_css_source('email')) %}
<html>
  <body class="font-sans">
    <div class="p-5 w-full bg-blue text-white">
      <div class="w-20 h-20">
        <img class="object-contain" width="100" height="100" src="{{ email.image('@mailasset/images/full-logo.png') }}" alt="Logo">
      </div>
    </div>
    <main class="p-10 w-full bg-white text-blue">
      {% block content %}

      {% endblock %}
    </main>
    <footer class="p-5 w-full bg-blue text-white">
      <p class="text-sm">
        © Jazzfreunde Ingolstadt e.V.
        {{ 'now' | date('Y') }}
      </p>
    </footer>
  </body>
</html>
{% endapply %}
