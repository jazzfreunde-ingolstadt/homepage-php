{% extends 'email/base.html.twig' %}

{% block content %}
	<h1 class="text-xl">Bitte bestätigen Sie Ihre Anmeldung</h1>

	<p class="text-md">
		Vielen Dank für Ihr Interesse an unseren Benachrichtigungen. Bitte bestätigen Sie Ihre E-Mail-Adresse, damit wir Ihnen die gewünschten Benachrichtigungen zusenden können.
	</p>

	<p class="text-md">
		Jazz on! 🎷
	</p>

	<p class="text-md">
		<a class="font-bold text-orange underline my-4" href="{{ url('notification_confirm', { token: token }) }}">Anmeldung bestätigen</a>
	</p>
{% endblock %}
