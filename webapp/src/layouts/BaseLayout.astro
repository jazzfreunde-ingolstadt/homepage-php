---
import { Head } from '@michemayer/astro-components/components'
import Footer from './partials/Footer.astro'
import ThemeProvider from '@components/providers/ThemeProvider.astro'
import type { Favicon } from '@michemayer/astro-components/models'
import * as styles from './BaseLayout.css.ts'
import { fontFaces } from '@/themes/font-faces.css'

// Import the global.css file here so that it is included on
// all pages through the use of the <BaseLayout /> component.
import '@/global.css'

interface Props {
  title: string
  description: string
  image?: string
}

const favicon: Favicon = {
  type: 'image/png',
  href: '/favicon.png',
}

const { title, description, image = 'full-logo-with-background.png' } = Astro.props
---

<html lang="de">
  <Head
    title={title}
    description={description}
    image={image}
    favicon={[favicon]}
    fontFaces={fontFaces}
  />
  <ThemeProvider as="body" classNames={styles.wrapper}>
    <div class={styles.stretchContent}>
      <main>
        Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat, sed diam voluptua. At vero eos et accusam et justo duo dolores et ea rebum. Stet clita kasd gubergren, no sea takimata sanctus est Lorem ipsum dolor sit amet. Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna aliquyam erat, sed diam voluptua. At vero eos et accusam et justo duo dolores et ea rebum. Stet clita kasd gubergren, no sea takimata sanctus est Lorem ipsum dolor sit amet.
        <slot />
      </main>
    </div>
    <Footer />
  </ThemeProvider>
</html>

