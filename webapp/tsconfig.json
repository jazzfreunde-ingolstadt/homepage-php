{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "strictNullChecks": true,
    "paths": {
      "src/*": ["./src/*"],
      "@/*": ["./src/*"],
      "@models/*": ["./src/models/*"],
      "@models": ["./src/models/index.ts"],
      "@themes/*": ["./src/themes/*"],
      "@components/*": ["./src/components/*"],
      "@utils/*": ["./src/utils/*"],
      "@layouts/*": ["./src/layouts/*"],
      "@assets/*": ["./src/assets/*"],
    }
  }
}