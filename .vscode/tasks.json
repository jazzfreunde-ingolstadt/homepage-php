{
	"version": "2.0.0",
	"tasks": [
        {
            "label": "composer install",
            "type": "shell",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "command": "composer install",
            "options": {
                "cwd": "${workspaceFolder}/src/",
            },
            "presentation": {
                "clear": true
            }
        },
        {
            "label": "npm install",
            "type": "shell",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "command": "npm install",
            "options": {
                "cwd": "${workspaceFolder}/src/",
            },
            "presentation": {
                "clear": true
            }
        },
        {
            "label": "Update autoloader",
            "detail": "Aktualisiere Autoloader Class Maps",
            "type": "shell",
            "problemMatcher": [],
            "group": "build",
            "command": "composer dump-autoload",
            "options": {
                "cwd": "${workspaceFolder}/src/",
            },
            "presentation": {
                "clear": true
            }
        },
        {
            "label": "Migrate database",
            "type": "shell",
            "group": "test",
            "command": "${workspaceFolder}/src/bin/console",
            "args": [
                "doctrine:migrations:migrate",
                "--no-interaction"
            ],
            "options": {
                "cwd": "${workspaceFolder}/src/",
            },
        },
        {
            "label": "Run Unit Tests",
            "type": "shell",
            "group": "test",
            "command": "${workspaceFolder}/src/bin/phpunit",
            "args": [
                "--testsuite=full"
            ],
            "options": {
                "cwd": "${workspaceFolder}/src/",
                "env": {}
            },
            "presentation": {
                "clear": true
            }
        },
        {
            "label": "Analyze code",
            "type": "shell",
            "group": "test",
            "command": "${workspaceFolder}/src/bin/psalm",
            "options": {
                "cwd": "${workspaceFolder}/src/",
            },
            "args": [
                "-c=psalm.xml",
            ],
            "problemMatcher": {
                "owner": "php",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}"
                ],
                "severity": "warning",
                "pattern": {
                    "regexp": "^(ERROR):\\s([^\\s]+)\\s-\\s([^:]+):([0-9]+):([0-9]+)\\s-\\s(.+)$",
                    "file": 3,
                    "line": 4,
                    "column": 5,
                    "severity": 1,
                    "message": 6,
                    "code": 2
                }
            },
            "presentation": {
                "showReuseMessage": false,
                "clear": true
            }
        },
	]
}