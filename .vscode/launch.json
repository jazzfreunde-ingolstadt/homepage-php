{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Listen for Xdebug",
            "type": "php",
            "request": "launch",
            "hostname": "localhost",
            "port": 9003,
            "log": false,
            "ignore": [
                "**/vendor/**/*.php"
            ],
            "xdebugSettings": {
                "max_children": 10000,
                "max_data": 10000,
                "show_hidden": 1
            }
        },
        {
            "name": "Launch migration in debug mode",
            "type": "php",
            "request": "launch",
            "program": "${workspaceFolder}/src/bin/console",
            "args": [
                "doctrine:migrations:migrate",
                "--no-interaction"
            ],
            "port": 9003,
            "runtimeExecutable": "/usr/local/bin/php",
            "env": {
                "XDEBUG_MODE": "debug",
                "XDEBUG_CONFIG": "client_host=127.0.0.1 client_port=9003",
                "DEBUG_MODE": "true",
                "XDEBUG_SESSION": "true"
            }
        }
    ]
}