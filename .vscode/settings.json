{
    "phpsab.composerJsonPath": "src",
    "phpsab.standard": "src/ruleset.xml,Security",
    "phpsab.fixerArguments": [
        "--ignore=src/legacy/*",
        "--ignore=src/vendor/*"
    ],
    "[php]": {
        "editor.defaultFormatter": "valeryanm.vscode-phpsab"
    },
    "[yaml]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[twig]": {
        "editor.defaultFormatter": "junstyle.twig-language"
    },
    "files.eol": "\n"
}