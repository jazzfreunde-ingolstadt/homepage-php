{
    "phpsab.composerJsonPath": "src",
    "phpsab.standard": "src/ruleset.xml,Security",
    "phpsab.fixerArguments": [ "--ignore=src/legacy/*,src/vendor/*" ],
    "phpsab.snifferArguments": [ "--ignore=src/legacy/*,src/vendor/*" ],
    "[php]": {
        "editor.defaultFormatter": "valeryanm.vscode-phpsab"
    },
    "[yaml]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[js]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[twig]": {
        "editor.defaultFormatter": "mblode.twig-language-2"
    },
    "files.eol": "\n",
    "files.exclude": {
        "**/.git": true,
        "**/var/cache": true,
    },
    "php-docblocker.alignParams": true,
    "php-docblocker.alignReturn": true,
    "php.suggest.basic": false
}