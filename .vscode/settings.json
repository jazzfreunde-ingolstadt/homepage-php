{
    "phpcs.composerJsonPath": "src",
    "phpcs.ignorePatterns": [
        "src/legacy/*",
        "src/vendor/*"
    ],
    "phpcs.standard": "src/ruleset.xml,Security",
    "phpcs.showWarnings": false,
    "phpcs.showSources": true,
    "phpsab.snifferEnable": false,
    "phpsab.composerJsonPath": "src",
    "phpsab.standard": "src/ruleset.xml,Security",
    "phpsab.fixerArguments": [
        "--ignore=src/legacy/*",
        "--ignore=src/vendor/*"
    ],
    "[php]": {
        "editor.defaultFormatter": "valeryanm.vscode-phpsab"
    },
    "[yaml]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "files.eol": "\n"
}