<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
      {% block title %}
        Welcome!
      {% endblock %}
    </title>
    <link rel="icon" href="/assets/images/jicon.svg" />
    {% block stylesheets %}
      {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
      {{ encore_entry_script_tags('app') }}
    {% endblock %}
  </head>
  <body>
    <div class="flex w-full min-h-screen flex-col content-center bg-grey-light">
      <div class="sticky top-0 w-full flex-none">
        {% include 'components/header.html.twig' %}
      </div>
      <main role="main" class="w-full grow flex flex-col">
        <div class="container mx-auto max-w-screen-xl px-5 md:px-20 text-blue">
          {% block content %}
          {% endblock %}
        </div>
      </main>
      {% include 'components/footer.html.twig' %}
    </div>
  </body>
</html>
