<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
		<meta name="description" content="Verein zur Förderung der Kunst und Kultur in Ingolstadt.">
		<title>
			{% block title %}
				Welcome!
			{% endblock %}
		</title>
		<link rel="icon" href="{{ asset('build/app/images/jicon.svg') }}"/>
		{% block stylesheets %}
			{{ encore_entry_link_tags('app', null, 'app') }}
		{% endblock %}

		{% block javascripts %}
			{{ encore_entry_script_tags('app', null, 'app') }}
		{% endblock %}
	</head>
	<body>
		<div class="flex flex-col min-h-screen">
			<div class="flex flex-row grow flex-nowrap w-full -mb-16">
				<div class="relative w-0 grow-0 justify-self-stretch z-20">
					<a class="nav-logo" href="{{ path('home') }}">
						<div class="sticky top-0 left-0" style="margin-top: -8px;">
							<svg class="absolute top-0 left-0 h-24 md:h-36 lg:h-48 w-24 md:w-36 lg:w-48 object-cover" viewbox="0 0 100 100">
								<g transform="rotate(30, 15, -40)">
									<rect class="fill-yellow" x="0" width="105" height="60" rx="30"/>
								</g>
								<g transform="rotate(30, 10, -35)">
									<rect class="fill-orange" x="0" width="132" height="50" rx="25"/>
								</g>
								<g transform="rotate(30, 50, -40)">
									<rect class="fill-yellow" x="0" width="135" height="20" rx="10"/>
								</g>
								<g transform="rotate(30, 40, -30)">
									<rect class="fill-blue" x="0" width="115" height="60" rx="30"/>
								</g>
							</svg>
							<div class="logo relative m-2 h-16 md:h-24 lg:h-36 w-16 md:w-24 lg:w-36 flex-none flex justify-center items-center">
								{% include 'components/logo.html.twig' %}
							</div>
						</div>
					</a>
				</div>
				<div class="w-full bg-white">
					{% include 'components/header.html.twig' %}
					<main role="main" class="relative w-full z-0 grow flex flex-col text-blue">{% block content %}{% endblock %}</main>
				</div>
			</div>
			{% include '@layout/divider.html.twig' with { classnames: "fill-blue h-16 z-10" } %}
			<div class="relative w-full flex-none">
				{% include 'components/footer.html.twig' %}
			</div>
		</div>
	</body>
</html>
