{% apply inline_css(encore_entry_css_source('email')) %}
<html>
  <body class="font-sans">
    <div class="p-5 w-full bg-blue text-white">
      <img class="w-20" src="{{ email.image('@mailasset/images/fulllogo.svg') }}" alt="Logo">
    </div>
    <main class="p-10 w-full">
      {% block content %}

      {% endblock %}
    </main>
    <footer class="p-5 w-full bg-blue text-white">
      <p class="text-sm">
        © Jazzfreunde Ingolstadt
        {{ 'now' | date('Y') }}
      </p>
  </body>
</html>
{% endapply %}
