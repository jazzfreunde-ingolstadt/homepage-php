{# Korrespondiert mit Höhe in components/header-spacer.html.twig #}
<header id="main-navigation" role="navigation" aria-expanded="false" class="max-lg:main-navigation-toggle lg:main-navigation-fixed lg:h-36 xl:48 overflow-hidden z-50 flex justify-center items-center duration-700">
	<div class="w-full h-full flex justify-center items-center text-white">
		<a href="javascript:void(0)" class="main-navigation-close lg:hidden absolute top-6 right-8 z-10 hover:text-yellow text-7xl font-semibold duration-300">&times;</a>
		<div
			class="lg:hidden absolute top-0 w-full h-full overflow-clip z-0 bg-blue opacity-95">{# <img src="{{ image_url|raw }}" class="object-cover" /> #}
		</div>
		<nav class="relative w-full z-10 overflow-visible text-xl sm:text-2xl md:text-3xl lg:text-3xl xl:text-4xl">
			{% embed '@layout/container.html.twig' %}
				{% block content %}
					{% include 'components/navigation/menu.html.twig' %}
				{% endblock %}
			{% endembed %}
		</nav>
	</div>
	<hr class="border-b-2 border-orange"/>
</header>
