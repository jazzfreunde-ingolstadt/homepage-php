{# Korrespondiert mit Höhe in components/header-spacer.html.twig #}
<header class="w-full absolute top-0 left-0 z-10 text-white">
	{% embed '@layout/container.html.twig' %}
		{% block content %}
			<div
				{{ react_component('Menu', {
					links: [
						{url: url('home'), label: 'Startseite'},
						{url: url('about'), label: 'Verein'},
						{url: url('events', { edit: false }), label: 'Veranstaltungen'},
						{url: url('join'), label: 'Mitglied werden'},
					],
					logo: {
						alt: 'Jazzfreunde Ingolstadt e.V. Logo',
						src: asset('build/app/images/jazzlogo.svg'),
						sources: [
							{
								srcset: asset('build/app/images/jazzlogo.svg'),
								media: '(min-width: 768px)',
							}
						],
					},
				})}}
			>
				{% import "components/util/loading-placeholder.html.twig" as name %}
			</div>
		{% endblock %}
	{% endembed %}
</header>
