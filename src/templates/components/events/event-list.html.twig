<table id="{{ event_list_id }}" class="eventlist termine" cellspacing="0" cellpadding="3" border="0" width="90%" align="center">
  <thead>
    <tr class="border-b border-orange text-md">
      <th width="20%">Datum</th>
      <th width="15%">Zeit</th>
      <th width="40%">Veranstaltung</th>
      <th width="25%">Ort</th>
    </tr>
  </thead>
  <tbody class="eventlist_body text-sm">
    <tr class="eventlist-item template border-b border-yellow" {{ app.debug ? ('data-sample-events="' ~ (data_samples|json_encode|escape('html_attr')) ~ '"')|raw }}>
      <td>
        <small class="uppercase text-xs first-letter:text-sm"><div class="event_weekday">{% include 'components/api/loading-schimmer.html.twig' with { length: 5 } %}</div></small><br />
        <div class="event_date">{% include 'components/api/loading-schimmer.html.twig' with { length: 10 } %}</div>
      </td>
      <td>
        <span class="event_time">{% include 'components/api/loading-schimmer.html.twig' with { length: 5 } %}</span>
      </td>
      <th class="text-md">
        <div class="event_titel">
          {% include 'components/api/loading-schimmer.html.twig' with { length: 50 } %}
        </div><br />
        <small class="text-xs">
          <div class="event_subtitel">
            {% include 'components/api/loading-schimmer.html.twig' with { length: 50 } %}
          </div>
        </small>
        <a class="event_link text-xs text-orange" target="_blank">{% include 'components/api/loading-schimmer.html.twig' with { length: 30 } %}</a>
      </th>
      <td>
        <span class="event_location">{% include 'components/api/loading-schimmer.html.twig' with { length: 20 } %}</span>
      </td>
    </tr>
    <tr class="eventlist_empty hidden">
      <td colspan="4" style="padding: 1em;">{{ messageOnEmpty }}</td>
    </tr>
    <tr class="placeholder_while_loading">
      <td colspan="4" style="text-align: center; padding: 1em;">
        <noscript>
          Um Veranstaltungen zu sehen, muss die Verwendung von Javascript zugelassen werden.<br />
        </noscript>
        {# <img class="m-auto" src="/gfx/icons/loading_icon.gif" style="width: 3em" /> #}
      </td>
    </tr>
  </tbody>
</table>
