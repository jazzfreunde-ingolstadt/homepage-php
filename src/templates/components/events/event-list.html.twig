<div id="{{ event_list_id }}" class="eventlist w-full">
  <div class="sticky top-0 mb-5 py-5 grid grid-cols-[minmax(6em,_.5fr)_minmax(3em,_.5fr)_2fr_1fr] font-bold bg-white border-b border-orange">
    <div class="px-2">Datum</div>
    <div class="px-2">Zeit</div>
    <div class="px-2">Veranstaltung</div>
    <div class="px-2 text-right">Ort</div>
  </div>
  <noscript class="text-center font-bold text-red">
    Um Veranstaltungen zu sehen, muss die Verwendung von Javascript zugelassen werden!<br />
  </noscript>
  {% for i in 1..3 %}
    <div class="eventlist-item template grid grid-cols-[minmax(6em,_.5fr)_minmax(3em,_.5fr)_2fr_1fr] border-b border-yellow" {{ app.debug ? ('data-sample-events="' ~ (data_samples|json_encode|escape('html_attr')) ~ '"')|raw }}>
      <div>
        <small class="uppercase text-xs first-letter:text-sm">
          <div class="event_weekday">
            {% include 'components/api/loading-schimmer.html.twig' with { length: 5 } %}
          </div>
        </small>
        <div class="event_date">
          {% include 'components/api/loading-schimmer.html.twig' with { length: 10 } %}
        </div>
      </div>
      <div>
        <span class="event_time">{% include 'components/api/loading-schimmer.html.twig' with { length: 5 } %}</span>
      </div>

      <div class="text-base">
        <div class="event_titel text-base font-bold">
          {% include 'components/api/loading-schimmer.html.twig' with { length: 50 } %}
        </div>
        <small class="text-xs">
          <div class="event_subtitel">
            {% include 'components/api/loading-schimmer.html.twig' with { length: 50 } %}
          </div>
        </small>
        <a class="event_link text-xs text-orange" target="_blank">{% include 'components/api/loading-schimmer.html.twig' with { length: 30 } %}</a>
      </div>

      <div class="text-right">
        <span class="event_location">{% include 'components/api/loading-schimmer.html.twig' with { length: 20 } %}</span>
      </div>
    </div>
  {% endfor %}
  <div class="eventlist_empty text-center hidden">
    <div>{{ messageOnEmpty }}</div>
  </div>
</div>
