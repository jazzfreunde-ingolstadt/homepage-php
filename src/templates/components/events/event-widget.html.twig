<div class="max-w-full mx-auto md:max-w-screen-xl my-5">
  {% include 'typography/section-titel.html.twig' with { titel: 'Kommende Veranstaltungen' } %}
  <div id="event-widget" class="w-full grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-5 justify-items-stretch">
    <div class="event-widget-card template" {{ app.debug ? ('data-sample-events="' ~ (data_samples|json_encode|escape('html_attr')) ~ '"')|raw }}>
      <div class="w-48 lg:w-64 h-full p-5 bg-white flex flex-col">
        <div class="text-lg font-bold mb-5">
          <span class="event_titel">{% include 'components/api/loading-schimmer.html.twig' with { length: 50 } %}</span></span>
        </div>
        <div class="grow my-2">
          <small class="text-xs"><span class="event_subtitel">{% include 'components/api/loading-schimmer.html.twig' with { length: 50 } %}</span></small>
          <span class="event_date">{% include 'components/api/loading-schimmer.html.twig' with { length: 10 } %}</span>
          <span class="event_time">{% include 'components/api/loading-schimmer.html.twig' with { length: 5 } %}</span>
        </div>
        <div>
          <span class="event_location">{% include 'components/api/loading-schimmer.html.twig' with { length: 20 } %}</span>
          <a class="event_link text-xs text-orange" target="_blank">{% include 'components/api/loading-schimmer.html.twig' with { length: 30 } %}</a>
        </div>
      </div>
    </div>
  </div>
</div>
