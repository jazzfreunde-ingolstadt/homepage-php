<div id="event-widget" class="w-full grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5 justify-items-stretch">
  <noscript class="text-center font-bold text-red">
    Um Veranstaltungen zu sehen, muss die Verwendung von Javascript zugelassen werden!<br />
  </noscript>
  {% for i in 1..3 %}
    <div class="eventlist-item template" {{ app.debug ? ('data-sample-events="' ~ (data_samples|json_encode|escape('html_attr')) ~ '"')|raw }}>
      <div class="w-full md:48 lg:w-72 h-full p-5 rounded-md border border-grey-light bg-white shadow-md overflow-hidden flex flex-col">
        <div class="text-lg font-bold mb-5">
          <span class="event_titel">{% include 'components/api/loading-schimmer.html.twig' with { length: 50 } %}</span>
        </div>
        <div class="grow my-2">
          <small class="text-sm"><span class="event_subtitel">{% include 'components/api/loading-schimmer.html.twig' with { length: 50 } %}</span></small>
          <span class="event_date">{% include 'components/api/loading-schimmer.html.twig' with { length: 10 } %}</span>
          <span class="event_time">{% include 'components/api/loading-schimmer.html.twig' with { length: 5 } %}</span>
        </div>
        <div>
          <span class="event_location">{% include 'components/api/loading-schimmer.html.twig' with { length: 20 } %}</span>
          <a class="event_link text-sm text-orange" target="_blank">{% include 'components/api/loading-schimmer.html.twig' with { length: 30 } %}</a>
        </div>
      </div>
    </div>
  {% endfor %}
</div>
