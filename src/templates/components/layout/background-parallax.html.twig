<style>
  @supports (overflow: clip) {
    .parallax-container {
      height: 2000vh;
      margin-top: -1000vh;
    }

    .parallax-container img {
      height: 100VH;
    }
  }
  
  @supports not (overflow: clip) {
    /*
    * Versionen < 16  von Safari untersttützen kein overflow-clip.
    * Um Overflow am Seitenende zu vermeiden wird die Containerhöhe in diesen Browser Versionen limitiert.
    * Damit wird der Parallax-Effekt deaktiviert.
    */
    .parallax-container {
      height: 100%;
    }
  
    .parallax-container img {
      height: 100%;
    }
  }
</style>
<div class="relative w-full min-h-min">
  <div class="absolute top-0 w-full h-full overflow-clip z-0">
    <div class="relative parallax-container">
      <img src="{{ image_url|raw }}" class="sticky top-0 w-full object-cover {{ class|default('') }}" />
    </div>
  </div>
  <div class="relative w-full z-10 overflow-x-hidden">
    {% block infront %}

    {% endblock %}
  </div>
</div>
