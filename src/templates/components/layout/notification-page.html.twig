{% extends 'base.html.twig' %}

{% set overrideBoxContent %}
    {% block notification %}{% endblock %}
 {% endset %}

{% block content %}
	{% embed '@layout/background-parallax.html.twig' with { image_url: asset(random_image('build/app/images/ambient/')|default('build/app/images/fulllogo.svg')), class: 'blur-sm brightness-75' } %}
		{% block infront %}
			{% include "components/header-spacer.html.twig" %}
			{% embed '@layout/container.html.twig' %}
				{% block content %}
					{% embed 'components/util/message-box.html.twig' %}
						{% block box_content %}
							{{ overrideBoxContent }}
						{% endblock %}
					{% endembed %}
					{% include "@layout/spacer.html.twig" %}
				{% endblock %}
			{% endembed %}
			{% include "components/footer-spacer.html.twig" %}
		{% endblock %}
	{% endembed %}
{% endblock %}
