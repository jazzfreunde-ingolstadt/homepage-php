{% extends 'base.html.twig' %}

{% block javascripts %}
  {{ parent() }}
  {{ encore_entry_script_tags('events', null, 'app') }}
{% endblock %}

{% block content %}
  {% embed 'layout/container.html.twig' %}
    {% block content %}
      {% include 'typography/titel.html.twig' with { titel: 'Veranstaltungskalender' } %}

      Hier finden Sie eine Übersicht über Veranstaltungen in der Region für Jazzfreunde (unabhängig davon, wer der Veranstalter ist):

      {% include 'typography/section-titel.html.twig' with { titel: 'Kommende Veranstaltungen' } %}
      <section class="py-5 md:py-10">
        {% include 'components/events/event-list.html.twig' with { event_list_id: 'upcoming_events', messageOnEmpty: 'Im Moment stehen keine Veranstaltungen an.', data_samples: sampledata.upcoming_events } %}
        <p class="my-2">
          Auch interessant: Das Programm unserer Partner des <a class="text-orange" href="https://www.birdland.de/programm/" target="_blank">Birdland Jazz Club Neuburg</a>!
        </p>
      </section>
    {% endblock %}
  {% endembed %}
  {% embed 'layout/background-parallax.html.twig' with { image_url: '/assets/images/placeholder/1.jpg', class: 'blur-sm' } %}
    {% block infront %}
      <hr class="invisible py-32" />
      <div class="bg-white">
        {% embed 'layout/container.html.twig' %}
          {% block content %}
            <section class="py-5 md:py-10">
              {% include 'typography/section-titel.html.twig' with { titel: 'Vergangene Veranstaltungen' } %}
              {% include 'components/events/event-list.html.twig' with { event_list_id: 'past_events', messageOnEmpty: 'Es sind keine vergangenen Veranstaltungen eingetragen.', data_samples: sampledata.past_events } %}
            </section>

            <section class="py-5 md:py-10">
              {% include 'typography/section-titel.html.twig' with { titel: 'Veranstaltungsarchiv' } %}
              <div id="show_archived" class="my-2 block cursor-pointer underline">Archiv anzeigen</div>
              <div id="archived_events_container" style="display:none;">
                {% include 'components/events/event-list.html.twig' with { event_list_id: 'archived_events', messageOnEmpty: 'Es befinden sich keine Veranstaltungen im Archiv.', data_samples: sampledata.archived_events } %}

                <div id="hide_archived" class="my-2 block cursor-pointer underline">Archiv verbergen</div>
              </div>
            </section>
          {% endblock %}
        {% endembed %}
      </div>
      <hr class="invisible py-32" />
    {% endblock %}
  {% endembed %}
{% endblock %}
