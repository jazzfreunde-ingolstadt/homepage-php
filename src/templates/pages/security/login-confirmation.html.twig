{% extends 'base.html.twig' %}

{% block content %}
  {% embed 'components/util/message-box.html.twig' with { image_url: '/assets/images/placeholder/1.jpg', class: 'blur-sm' } %}
    {% block box_content %}
      <p class="text-3xl mb-3 md:mb-5 font-bold text-orange">Login</p>
      <p class="text-xl mb-3 md:mb-5 font-bold">Ich möchte mich authentifizieren.</p>
      <form action="{{ path(login_check) }}" method="POST">
        <div class="w-full flex flex-col md:flex-row gap-5 lg:gap-10">
          <input type="hidden" name="expires" value="{{ _expires }}" />
          <input type="hidden" name="user" value="{{ _user }}" />
          <input type="hidden" name="hash" value="{{ _hash }}" />
          <div class="relative flex-none">
            <button class="bg-orange hover:bg-yellow text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline" type="submit">Fortfahren</button>
          </div>
        </div>
      </form>
    {% endblock %}
  {% endembed %}
{% endblock %}
