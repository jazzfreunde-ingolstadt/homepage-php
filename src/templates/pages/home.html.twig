{% extends 'base.html.twig' %}

{% block javascripts %}
	{{ parent() }}
	{{ encore_entry_script_tags('home', null, 'app') }}
{% endblock %}

{% block content %}
	{% embed '@layout/background-parallax.html.twig' with { image_url: asset('build/app/images/ambient/session-bright11.jpg'), class: 'brightness-90' } %}
		{% block infront %}
			{% embed '@layout/container.html.twig' %}
				{% block content %}
					<div class="flex flex-col align-middle justify-center h-screen text-center font-sans">
						<h1 class="p-10 text-4xl md:text-6xl lg:text-8xl font-bold text-white backdrop-blur-sm backdrop-brightness-90">Jazzfreunde
							<span class="whitespace-nowrap">Ingolstadt e.V.</span>
						</h1>
					</div>
				{% endblock %}
			{% endembed %}
			{% include '@layout/divider.html.twig' with { classnames: "fill-white h-16" } %}
		{% endblock %}
	{% endembed %}

	{% embed '@layout/container.html.twig' %}
		{% block content %}
			<div class="my-16 lg:my-24 xl:my-36">
				{% include 'typography/section-titel.html.twig' with { titel: 'Kommende Veranstaltungen' } %}
				{% include 'components/events/event-widget.html.twig' with { data_samples: sampledata.featured_events } %}
			</div>
		{% endblock %}
	{% endembed %}

	{% include "components/footer-spacer.html.twig" %}
{% endblock %}
