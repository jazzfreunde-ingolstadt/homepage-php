{% extends 'base.html.twig' %}

{% block javascripts %}
	{{ parent() }}
	{{ encore_entry_script_tags('home', null, 'app') }}
{% endblock %}

{% block header_element %}
	{% include 'components/information/actions.html.twig' with { class: 'w-full' }  %}
{% endblock %}

{% block content %}
	{% embed '@layout/container.html.twig' %}
		{% block content %}
			{% include 'typography/section-titel.html.twig' with { titel: 'Gemeinsam die Jazzszene in Ingolstadt unterstützen!' } %}

			<article class="text-justify">
				{{ include('@markdown/home/donation-letter.md.twig')|markdown_to_html }}
			</article>
		{% endblock %}
	{% endembed %}

	{% include "components/footer-spacer.html.twig" %}
{% endblock %}
