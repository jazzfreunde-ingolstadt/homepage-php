{% extends 'base.html.twig' %}

{% block javascripts %}
	{{ parent() }}
	{{ encore_entry_script_tags('home', null, 'app') }}
{% endblock %}

{% block header_element %}
	{% embed '@layout/background-parallax.html.twig' with { image_url: asset('build/app/images/ambient/session-bright11.jpg'), class: 'blur-sm brightness-75 scale-110' } %}
		{% block infront %}
			{% include "components/header-spacer.html.twig" %}
			{% embed '@layout/container.html.twig' %}
				{% block content %}
					<div class="flex place-content-center place-items-center h-screen text-center font-sans">
						<div class="h-3/4 inline-block overflow-hidden">
							<img class="h-3/4 mx-auto" src="{{ asset('build/app/images/jazzlogo.svg') }}" alt="Jazzfreunde Ingolstadt e.V. Logo"/>
							<h1 class="relative text-[6vh] font-bold text-white">
								Jazzfreunde<br/><span class="whitespace-nowrap">Ingolstadt e.V.</span>
							</h1>
						</div>
					</div>
				{% endblock %}
			{% endembed %}
		{% endblock %}
	{% endembed %}
{% endblock %}

