{% extends 'base.html.twig' %}

{% block javascripts %}
  {{ parent() }}
  {{ encore_entry_script_tags('home') }}
{% endblock %}

{% block content %}
  {% embed 'layout/container.html.twig' %}
    {% block content %}
      <div class="mb-20">
        {% include 'typography/section-titel.html.twig' with { titel: 'Kommende Veranstaltungen' } %}
        {% include 'components/events/event-widget.html.twig' with { data_samples: sampledata.featured_events } %}
      </div>
    {% endblock %}
  {% endembed %}
  {% embed 'layout/background-parallax.html.twig' with { image_url: '/assets/images/placeholder/1.jpg' } %}
    {% block infront %}
      {% embed 'layout/container.html.twig' %}
        {% block content %}
          <div class="bg-white rounded-xl shadow-md my-32 p-8">
            {% include 'components/newsletter/subscription-widget.html.twig' %}
          </div>
        {% endblock %}
      {% endembed %}
    {% endblock %}
  {% endembed %}
{% endblock %}
