{% extends 'base.html.twig' %}

{% block header_element %}
	{% embed '@layout/background-parallax.html.twig' with { image_url: asset('build/app/images/ambient/session-saturated2.jpg'), class: 'blur-sm brightness-75 scale-110' } %}
		{% block infront %}
			{% include "components/header-spacer.html.twig" %}
			{% embed '@layout/container.html.twig' %}
				{% block content %}
					<div class="my-32 sm:my-36 md:my-48 lg:py-24 xl:py-48 font-sans">
						<h1 class="text-2xl sm:text-4xl md:text-6xl lg:text-7xl xl:text-8xl font-bold uppercase text-white">Satzung Jazzfreunde Ingolstadt</h1>
					</div>
				{% endblock %}
			{% endembed %}
		{% endblock %}
	{% endembed %}
{% endblock %}

{% block content %}
	{% embed '@layout/container.html.twig' %}
		{% block content %}
			<style>
				ol,
				ul {
					display: block;
					list-style-position: outside;
					padding-left: 2em;
					margin-bottom: 2em;
				}

				ol {
					list-style-type: decimal;
				}

				ol ol {
					list-style-type: lower-alpha;
				}

				ol ul {
					list-style-type: square;
				}
			</style>
			<section class="py-5 md:py-10">
				{{ include('@markdown/legal/satzung.md.twig')|markdown_to_html }}
				<br/>
				<a class="mt-5 text-orange" href="#" onclick="history.back()">Zurück</a>
			</section>
		{% endblock %}
	{% endembed %}

	{% include "components/footer-spacer.html.twig" %}
{% endblock %}
