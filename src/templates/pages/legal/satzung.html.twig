{% extends 'base.html.twig' %}

{% block content %}
	{% embed 'components/layout/background-parallax.html.twig' with { image_url: asset('build/app/images/ambient/session-moody6.jpg'), class: 'blur-sm brightness-75' } %}
		{% block infront %}
			{% include "components/header-spacer.html.twig" %}
			{% embed 'components/layout/container.html.twig' %}
				{% block content %}
					<div class="p-5 mb-20 font-sans">
						<h1 class="text-8xl font-bold uppercase my-10 text-white">Satzung Jazzfreunde Ingolstadt</h1>
					</div>
				{% endblock %}
			{% endembed %}
			{% include 'components/layout/divider.html.twig' with { classnames: "fill-white h-16" } %}
		{% endblock %}
	{% endembed %}

	{% embed 'components/layout/container.html.twig' %}
		{% block content %}
			<style>
				ol,
				ul {
					display: block;
					list-style-position: outside;
					padding-left: 2em;
					margin-bottom: 2em;
				}

				ol {
					list-style-type: decimal;
				}

				ol ol {
					list-style-type: lower-alpha;
				}

				ol ul {
					list-style-type: square;
				}
			</style>
			<section class="py-5 md:py-10">
				{{ include('markdown/legal/satzung.md.twig')|markdown_to_html }}
				<br/>
				<a class="mt-5 text-orange" href="#" onclick="history.back()">Zurück</a>
			</section>
		{% endblock %}
	{% endembed %}

	{% include "components/footer-spacer.html.twig" %}
{% endblock %}
