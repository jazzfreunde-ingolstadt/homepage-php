{% set title = 'Satzung' %}

{% extends 'base.html.twig' %}

{% block header_element %}
	{% embed '@layout/intro-banner.html.twig' with { image_url: asset('app/images/ambient/session-moody6.jpg') } %}
		{% block intro %}
			{% include 'typography/intro-titel.html.twig' with { titel: 'Satzung der Jazzfreunde Ingolstadt' } %}
		{% endblock %}
	{% endembed %}
{% endblock %}

{% block content %}
	{% embed '@layout/container.html.twig' %}
		{% block content %}
			<style>
				ol,
				ul {
					display: block;
					list-style-position: outside;
					padding-left: 2em;
					margin-bottom: 2em;
				}

				ol {
					list-style-type: decimal;
				}

				ol ol {
					list-style-type: lower-alpha;
				}

				ol ul {
					list-style-type: square;
				}
			</style>
			<section class="py-5 md:py-10">
				{{ include('@markdown/legal/satzung.md.twig')|markdown_to_html }}
			</section>
		{% endblock %}
	{% endembed %}

	{% include "components/footer-spacer.html.twig" %}
{% endblock %}
