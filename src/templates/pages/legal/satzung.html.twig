{% extends 'base.html.twig' %}

{% block content %}
  {% embed 'layout/container.html.twig' %}
    {% block content %}
      {% include 'typography/titel.html.twig' with { titel: 'Satzung Jazzfreunde Ingolstadt' } %}

      <style>
        ol,ul {
          display: block;
          list-style-position: outside;
          padding-left: 2em;
          margin-bottom: 2em;
        }

        ol {
          list-style-type: decimal;
        }

        ol ol {
          list-style-type: lower-alpha;
        }

        ol ul {
          list-style-type: square;
        }
      </style>
      <section class="testing mb-10">
        {{ include('markdown/legal/satzung.md.twig')|markdown_to_html }}
        <br />
        <a class="mt-5 text-orange" href="#" onclick="history.back()">Zurück</a>
      </section>
    {% endblock %}
  {% endembed %}
{% endblock %}
