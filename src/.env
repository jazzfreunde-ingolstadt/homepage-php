APP_ENV=prod
APP_DEBUG=0
APP_SECRET=
APP_VERSION=v9.99.99
DATABASE_URL='mysql://${IONOS_DB_USERNAME}:${IONOS_DB_PASSWORD}@${IONOS_DB_HOST}/${IONOS_DB_NAME}'
MAILER_DSN="smtp://{{.secrets.IONOS_MAIL_USERNAME}}:{{urlquery .secrets.IONOS_MAIL_PASSWORD}}@{{.secrets.IONOS_MAIL_HOST}}:{{.secrets.IONOS_MAIL_PORT}}"
MAIL_ENCRYPTION=$IONOS_MAIL_ENCRYPTION
MAIL_FROM_ADDRESS=$IONOS_MAIL_FROM_ADDRESS