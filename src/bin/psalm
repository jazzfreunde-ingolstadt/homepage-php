#!/usr/bin/env php
<?php
define('PROJECT_DIR', dirname(__DIR__));

if (!is_file(PROJECT_DIR.'/vendor/autoload.php')) {
    fwrite(
    STDERR,
        sprintf(
            'Vendor Bibliotheken können nicht geladen werden.'.PHP_EOL,
            'Stellen Sie sicher, dass Composer alle Abhängigkeiten installiert hat.'
        )
    );
    exit;
}

require PROJECT_DIR.'/vendor/vimeo/psalm/psalm';
