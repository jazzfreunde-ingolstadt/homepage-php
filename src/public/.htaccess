AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase "/"

    # RewriteCond %{HTTPS} off [OR]
    # RewriteCond %{HTTP_HOST} ^www\. [NC]
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=302]

    # Add trailing slash to url
    RewriteCond %{REQUEST_METHOD} !^(POST) [NC]
    RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]{1,5}|/|#(.*))$
    RewriteRule ^(.*)$ /$1/ [R=302,L]

    # Remove php extension:
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(([^/]+/)*([^/.]+))\.php[\ ?]
	RewriteRule \.php$ /%1/ [R=302,QSA,NC,L]

    # Funnel page requests to index and try to serve content:
    RewriteCond %{REQUEST_URI} /(.+?)/$
    RewriteCond pages/%1.php -F
    RewriteRule ^(.*)$ index.php [QSA,END]

    # Funnel api requests to index and try to serve content:
    RewriteCond %{REQUEST_URI} /(.+)/$
    #RewriteCond api/%1.php -F
    RewriteRule ^(.*)$ api/index.php [QSA,END]

    # Rewrite requested resources from legacy pages:
    RewriteCond %{REQUEST_URI} /(.+?)/$
    RewriteCond legacy/pages/%1.php -F
    RewriteRule . legacy/pages/%1.php [QSA,NS,L]
    
    # Try serving any file not found from legacy directory:
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond legacy/%{REQUEST_URI} -F
    RewriteRule . legacy/%{REQUEST_URI} [PT]
</IfModule>

<Files .htaccess>
	Order allow,deny
	Deny from all
</Files>

# ErrorDocument 404 /index.php/404