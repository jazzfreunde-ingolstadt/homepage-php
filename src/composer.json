{
    "name": "mga-api/libs",
    "authors": [
        {
            "name": "Michael Mayer",
            "email": "michael.mayer@adkomm.de",
            "role": "Anwendungsentwickler"
        }
    ],
    "require": {
        "symfony/dotenv": "5.2.*",
        "symfony/ldap": "5.2.*",
        "symfony/orm-pack": "2.1.*",
        "symfony/deprecation-contracts": "2.2.*",
        "symfony/error-handler": "5.2.*",
        "symfony/filesystem": "5.2.*",
        "symfony/routing": "5.2.*",
        "symfony/browser-kit": "5.2.*"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "3.*",
        "pheromone/phpcs-security-audit": "2.0.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7.1",
        "escapestudios/symfony2-coding-standard": "3.x-dev"
    },
    "scripts": {
        "post-install-cmd": [
            "[ $COMPOSER_DEV_MODE -eq 0 ] || vendor/bin/phpcs --config-set installed_paths vendor/escapestudios/symfony2-coding-standard,vendor/pheromone/phpcs-security-audit"
        ]
    }
}