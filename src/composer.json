{
    "name": "jazzfreunde-ingolstadt/php-homepage",
    "authors": [
        {
            "name": "Michael Mayer",
            "email": "business.miche.mayer@outlook.de",
            "role": "Webmaster"
        }
    ],
    "require": {
        "php": ">=8.1",
        "api-platform/core": "^3.0",
        "doctrine/annotations": "^1.13",
        "doctrine/doctrine-bundle": "^2.7",
        "doctrine/doctrine-migrations-bundle": "^3.2",
        "doctrine/orm": "^2.13",
        "jms/serializer-bundle": "^4.2",
        "michemayer/php-components": "1.0.0",
        "monolog/monolog": "^3.2",
        "sensio/framework-extra-bundle": "^6.2",
        "symfony/asset": "^6.1",
        "symfony/browser-kit": "^6.1",
        "symfony/console": "^6.1",
        "symfony/deprecation-contracts": "^3.1",
        "symfony/dotenv": "^6.1",
        "symfony/error-handler": "^6.1",
        "symfony/expression-language": "^6.1",
        "symfony/filesystem": "^6.1",
        "symfony/flex": "^2.2",
        "symfony/framework-bundle": "^6.1",
        "symfony/ldap": "^6.1",
        "symfony/maker-bundle": "^1.47",
        "symfony/monolog-bundle": "^3.8",
        "symfony/runtime": "^6.1",
        "symfony/security-bundle": "^6.1",
        "symfony/twig-bundle": "^6.1",
        "symfony/webpack-encore-bundle": "^1.16",
        "symfony/yaml": "^6.1",
        "thecodingmachine/safe": "^2.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "squizlabs/php_codesniffer": "^3.7.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7.2",
        "escapestudios/symfony2-coding-standard": "3.x-dev",
        "pheromone/phpcs-security-audit": "2.0.1",
        "psalm/plugin-phpunit": "dev-master",
        "vimeo/psalm": "^5.0.0-beta1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../packages/php/components"
        }
    ],
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd"
        },
        "install-codestandards": [
            "Dealerdirect\\Composer\\Plugin\\Installers\\PHPCodeSniffer\\Plugin::run"
        ],
        "post-install-cmd": [
            "@install-codestandards",
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "6.1.*"
        },
        "src-dir": "app/"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "symfony/runtime": true,
            "symfony/flex": true
        }
    },
    "autoload": {
        "psr-4": {
            "Jazzfreunde\\App\\": "app/",
            "Jazzfreunde\\Type\\": "Type/"
        }
    }
}
